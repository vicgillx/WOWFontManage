{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WOWFont",
  "version": "0.1.0",
  "identifier": "com.wowfontmanage.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WOWFont",
        "width": 1280,
        "height": 900,
        "minWidth": 980,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "WOWFontManage",
    "category": "Utility",
    "shortDescription": "Cross-platform World of Warcraft font manager",
    "longDescription": "WOWFont manages World of Warcraft font packs for Windows and macOS clients."
  }
}
